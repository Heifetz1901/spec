# 统一换行符：文本文件入库一律 LF，Windows/Mac 两端行为一致
* text=auto

# 脚本类必须 LF（否则 Linux/macOS 上无法执行）
*.sh   text eol=lf
*.bash text eol=lf

# Windows 专用脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件：禁止任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.jar  binary
